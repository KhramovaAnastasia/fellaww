function Services() {
  const [openIdx, setOpenIdx] = React.useState(0);
  return (
    <section id="services" className="section services">
      <div className="wrap">
        <div className="head">
          <div>
            <div className="eyebrow" style={{ marginBottom: 32 }}>
              <span className="dot"></span>II — Практики
            </div>
            <h2 className="serif">
              Пять <em>направлений</em>,<br />
              одно бюро.
            </h2>
          </div>
          <p>Каждая практика&nbsp;— это лид-партнёр и&nbsp;команда юристов с&nbsp;индустриальным бэкграундом. Мы&nbsp;не&nbsp;распыляемся: берёмся только за&nbsp;то, что умеем делать на&nbsp;уровне.</p>
        </div>

        <div className="practice-list">
          {PRACTICES.map((p, i) =>
          <div
            key={i}
            className={`practice ${openIdx === i ? 'open' : ''}`}
            onClick={() => setOpenIdx(openIdx === i ? -1 : i)}>
            
              <div className="n">— {p.n}</div>
              <div className="body-col">
                <h3 className="serif" dangerouslySetInnerHTML={{ __html: p.title }} />
                <div className="desc" dangerouslySetInnerHTML={{ __html: p.desc }} />
              </div>
              <div className="toggle">
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
                  <path d="M7 1 V13 M1 7 H13" stroke="currentColor" strokeWidth="1.4" />
                </svg>
              </div>
              <div className="expand">
                <div className="expand-inner">
                  <div>
                    <h5>Что входит</h5>
                    <ul>
                      {p.list.map((li, j) =>
                    <li key={j}><span></span><span dangerouslySetInnerHTML={{ __html: li }} /></li>
                    )}
                    </ul>
                  </div>
                  <div>
                    <h5>Стоимость</h5>
                    <div style={{ font: '400 38px/1 Cormorant Garamond', color: '#0F0F10', letterSpacing: '-0.02em' }}>{p.price}</div>
                    <span className="price">— фиксированный пакет или&nbsp;ретейнер</span>
                    <a href="#contact" style={{ display: 'inline-flex', alignItems: 'center', gap: 10, marginTop: 32, font: '500 12px/1 Inter Tight', letterSpacing: '0.16em', textTransform: 'uppercase', color: '#6B1F2A', borderBottom: '1px solid #6B1F2A', paddingBottom: 6 }}>
                      Обсудить задачу <span>→</span>
                    </a>
                  </div>
                </div>
              </div>
            </div>
          )}
        </div>
      </div>
    </section>);

}

const CASES = [
