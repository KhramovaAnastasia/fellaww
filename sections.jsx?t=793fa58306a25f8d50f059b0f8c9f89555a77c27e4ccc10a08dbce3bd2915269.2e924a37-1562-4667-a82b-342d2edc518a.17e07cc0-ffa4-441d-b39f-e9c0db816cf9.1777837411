{ kind: 2, code: 'FW—019', size: 'md', cat: 'Музыка', year: '2025', title: 'Splits для лейбла <em>Studio 7</em>', desc: 'Перестроили роялти-сетку для&nbsp;14&nbsp;артистов под&nbsp;digital-релизы.' },
{ kind: 3, code: 'FW—016', size: 'sm', cat: 'Дизайн', year: '2024', title: 'Коллаб <em>×</em> Maison Plié', desc: 'Договорная архитектура коллаборации в&nbsp;3 странах.' },
{ kind: 4, code: 'FW—011', size: 'sm', cat: 'Кино', year: '2024', title: 'Опцион на&nbsp;экранизацию', desc: 'Закрыли сделку между&nbsp;студией и&nbsp;автором за&nbsp;3 недели.' },
{ kind: 5, code: 'FW—008', size: 'md', cat: 'E-com', year: '2024', title: 'Снятие контрафакта на&nbsp;маркетплейсах', desc: '72 карточки удалены, претензия принята, ущерб возмещён.' },
{ kind: 6, code: 'FW—003', size: 'lg', cat: 'Гастрономия', year: '2023', title: 'Запуск сети <em>Komoda</em>', desc: 'Полный юридический контур: бренд, франшиза, поставщики, импорт сыров.' }];


function Cases() {
  return (
    <section id="cases" className="section cases">
      <div className="wrap">
        <div className="cases-head">
          <div>
            <div className="eyebrow" style={{ marginBottom: 32 }}>
              <span className="dot"></span>III — Избранные кейсы
            </div>
            <h2 className="serif">Что мы&nbsp;уже <em>сделали</em>.</h2>
          </div>
          <p>За&nbsp;последние три года&nbsp;— 47&nbsp;брендов, 9&nbsp;юрисдикций, 0&nbsp;разглашённых имён без&nbsp;согласия клиента. Ниже&nbsp;— те, кто&nbsp;разрешил рассказать.</p>
        </div>
        <div className="case-grid">
          {CASES.map((c, i) =>
          <article key={i} className={`case ${c.size}`}>
              <div className="img"><CasePattern kind={c.kind} code={c.code} /></div>
              <div className="meta">
                <div className="tag-row">
                  <span>{c.cat}</span>
                  <span className="yr">{c.year}</span>
                </div>
                <h4 className="serif" dangerouslySetInnerHTML={{ __html: c.title }} />
                <p dangerouslySetInnerHTML={{ __html: c.desc }} />
              </div>
            </article>
          )}
        </div>
      </div>
    </section>);

}

const TEAM = [
{ num: '01', name: 'Анна <em>Розамберг</em>', role: 'Управляющий партнёр / IP, мода' },
{ num: '02', name: 'Михаил <em>Гранов</em>', role: 'Партнёр / музыка, авторское право' },
{ num: '03', name: 'София <em>Лем</em>', role: 'Старший юрист / контракты' },
{ num: '04', name: 'Илья <em>Бек</em>', role: 'Старший юрист / споры' }];


function Team() {
  return (
    <section id="team" className="section team">
      <div className="wrap">
        <div className="team-head">
          <div>
            <div className="eyebrow" style={{ marginBottom: 32 }}>
              <span className="dot"></span>IV — Бюро
            </div>
            <h2 className="serif">Маленькая команда,<br />большие <em>дела</em>.</h2>
          </div>
          <p>Четверо партнёров и&nbsp;шесть юристов. Мы&nbsp;сознательно не&nbsp;растём «вширь»&nbsp;— чтобы&nbsp;каждый клиент знал, кто&nbsp;именно ведёт его дело и&nbsp;кто&nbsp;берёт трубку в&nbsp;пятницу вечером.</p>
        </div>
        <div className="team-grid">
          {TEAM.map((p, i) =>
          <div key={i} className="person">
              <div className="portrait">
                <span className="num">— {p.num}</span>
                <PortraitPlaceholder kind={i} num={p.num} />
              </div>
              <div className="name serif" dangerouslySetInnerHTML={{ __html: p.name }} />
              <div className="role">{p.role}</div>
            </div>
          )}
        </div>

        <div className="stats">
          <div className="stat">
            <div className="lg serif"><em>47</em></div>
            <div className="lbl">Действующих клиентов в&nbsp;креативных индустриях</div>
          </div>
          <div className="stat">
            <div className="lg serif"><em>9</em></div>
            <div className="lbl">Юрисдикций, в&nbsp;которых&nbsp;мы регистрировали знаки</div>
          </div>
          <div className="stat">
            <div className="lg serif"><em>312</em></div>
            <div className="lbl">Заключённых контрактов и&nbsp;лицензий за&nbsp;2025</div>
          </div>
          <div className="stat">
            <div className="lg serif"><em>0</em></div>
            <div className="lbl">Утечек&nbsp;NDA. И&nbsp;это не&nbsp;случайность.</div>
          </div>
        </div>
      </div>
    </section>);

}

function Contact() {
  const [form, setForm] = React.useState({
    name: '', company: '', email: '', task: '', industry: '', budget: ''
  });
  const [focus, setFocus] = React.useState('');
  const [sent, setSent] = React.useState(false);

  const set = (k) => (e) => setForm({ ...form, [k]: e.target.value });
  const submit = (e) => {
    e.preventDefault();
    if (!form.name || !form.email) return;
    setSent(true);
  };

  const industries = ['Мода', 'Музыка', 'Дизайн', 'Кино', 'Гастро', 'Реклама', 'Другое'];
  const budgets = ['до 100k', '100–300k', '300k–1M', 'от 1M', 'обсудим'];

  return (
    <section id="contact" className="contact">
      <div className="wrap">
        <div className="head">
          <div>
            <div className="eyebrow" style={{ marginBottom: 32, color: '#E1A6AE' }}>
              <span className="dot" style={{ background: '#E1A6AE' }}></span>V — Контакты
            </div>
            <h2 className="serif">Расскажите про&nbsp;<em>задачу</em>.</h2>
            <p className="lede" style={{ marginTop: 32, maxWidth: 520 }}>Отвечаем в&nbsp;течение рабочего дня. Первая консультация&nbsp;— 30 минут, бесплатно.</p>
          </div>
          <div>
            <div className="info">
              <div className="grp">
                <div className="lbl">Email</div>
                <div className="v"><a href="mailto:hello@follaw.ru">hello@follaw.ru</a></div>
              </div>
              <div className="grp">
                <div className="lbl">Телефон</div>
                <div className="v mono">+7 495 000 22 26</div>
              </div>
              <div className="grp">
                <div className="lbl">Адрес</div>
                <div className="v">Москва, Большой Гнездниковский,&nbsp;7</div>
              </div>
              <div className="grp">
                <div className="lbl">Часы</div>
                <div className="v mono">пн–пт &nbsp;10:00 — 19:00</div>
              </div>
            </div>
          </div>
        </div>

        {sent ?
        <div className="form">
            <div className="sent">
              <div className="ico">✓</div>
              <div className="t">Спасибо. Мы&nbsp;уже читаем&nbsp;ваше сообщение&nbsp;— <span className="accent">ответим в&nbsp;течение рабочего дня</span>.</div>
            </div>
          </div> :

        <form className="form" onSubmit={submit}>
            <div className={`field ${focus === 'name' ? 'focused' : ''}`}>
              <label>Имя</label>
              <input value={form.name} onChange={set('name')} onFocus={() => setFocus('name')} onBlur={() => setFocus('')} placeholder="Как к&nbsp;вам обращаться" />
            </div>
            <div className={`field ${focus === 'company' ? 'focused' : ''}`}>
              <label>Бренд / компания</label>
              <input value={form.company} onChange={set('company')} onFocus={() => setFocus('company')} onBlur={() => setFocus('')} placeholder="название или сайт" />
            </div>
            <div className={`field ${focus === 'email' ? 'focused' : ''}`}>
              <label>Контакт</label>
              <input value={form.email} onChange={set('email')} onFocus={() => setFocus('email')} onBlur={() => setFocus('')} placeholder="email или телеграм" />
            </div>
            <div className="field">
              <label>Индустрия</label>
              <div className="chips">
                {industries.map((c, i) =>
              <button type="button" key={i} className={`chip ${form.industry === c ? 'active' : ''}`} onClick={() => setForm({ ...form, industry: c })}>{c}</button>
              )}
              </div>
            </div>
            <div className={`field full ${focus === 'task' ? 'focused' : ''}`}>
              <label>Задача</label>
              <textarea value={form.task} onChange={set('task')} onFocus={() => setFocus('task')} onBlur={() => setFocus('')} placeholder="в двух абзацах: что у&nbsp;вас происходит и&nbsp;к&nbsp;какому сроку нужен ответ" />
            </div>
            <div className="field full">
              <label>Бюджет / формат</label>
              <div className="chips">
                {budgets.map((c, i) =>
              <button type="button" key={i} className={`chip ${form.budget === c ? 'active' : ''}`} onClick={() => setForm({ ...form, budget: c })}>{c}</button>
              )}
              </div>
            </div>
            <div className="submit-row">
              <div className="small">Отправляя форму, вы&nbsp;соглашаетесь с&nbsp;политикой обработки данных. Информация остаётся между&nbsp;нами&nbsp;— даже до&nbsp;подписания NDA.</div>
              <button type="submit" className="submit">Отправить <span className="arrow">→</span></button>
            </div>
          </form>
        }
      </div>
    </section>);

}

function Footer() {
  return (
    <footer className="footer">
      <div className="wrap">
        <div className="row">
