function Nav({ scrolled }) {
  return (
    <nav className={`nav ${scrolled ? 'scrolled' : ''}`}>
      <div className="row">
        <a href="#top" className="brand">
          Foll<span className="a">a</span>w<span className="dot"></span>
        </a>
        <div className="nav-links">
          <a href="#manifest">Манифест</a>
          <a href="#services">Практики</a>
          <a href="#cases">Кейсы</a>
          <a href="#team">Бюро</a>
          <a href="#contact" className="nav-cta">
            Написать <span className="arrow">→</span>
          </a>
        </div>
      </div>
    </nav>);

}

function Hero() {
  return (
    <section id="top" className="hero">
      <div className="wrap">
        <div className="top-meta">
          <div className="eyebrow">
            <span className="dot"></span>
            Юридическое бюро — Москва, 2026
          </div>
          <div className="dotline"></div>
          <div className="mono" style={{ color: '#8A8275' }}>FW—2026 / № 001</div>
        </div>

        <h1 className="serif">
          <span className="h1-row">Право для тех,</span>
          <span className="h1-row">кто <em style={{ color: "rgb(107, 31, 57)" }}>создаёт</em> культуру.</span>
        </h1>
        <p className="sub">
          Сопровождаем бренды и&nbsp;авторов в&nbsp;креативных индустриях&nbsp;— от&nbsp;первой капсулы до&nbsp;международного релиза. Без&nbsp;официоза, но&nbsp;без&nbsp;скидок на&nbsp;серьёзность.
        </p>

        <div className="tag-grid">
          {INDUSTRIES.map((t, i) =>
          <a
            key={i}
            href="#services"
            className={`tag ${t.size === 'feat' ? 'feat' : ''} ${t.size === 'wide' ? 'wide' : ''} ${t.size === 'thin' ? 'thin' : ''}`} style={{ backgroundColor: "rgb(107, 31, 53)" }}>
            
              <span className="nm">
                <span className="c">{t.code}</span>
                {t.name}
              </span>
              <span className="arr">
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
                  <path d="M3 11 L11 3 M5 3 H11 V9" stroke="currentColor" strokeWidth="1.2" strokeLinecap="square" />
                </svg>
              </span>
            </a>
          )}
        </div>

        <div className="strip">
          <div className="strip-track">
            {Array.from({ length: 2 }).map((_, j) =>
            <React.Fragment key={j}>
                <span>Авторское право<span className="d"></span></span>
                <span>Товарные знаки<span className="d"></span></span>
                <span>Коллаборации<span className="d"></span></span>
                <span>Лицензирование<span className="d"></span></span>
                <span>Споры с маркетплейсами<span className="d"></span></span>
                <span>NDA / контракты<span className="d"></span></span>
                <span>GR в индустрии<span className="d"></span></span>
                <span>M&amp;A для брендов<span className="d"></span></span>
              </React.Fragment>
            )}
          </div>
        </div>
      </div>
    </section>);

}

function Manifesto() {
  return (
    <section id="manifest" className="section">
      <div className="wrap manifesto">
        <div>
          <div className="eyebrow" style={{ marginBottom: 32 }}>
            <span className="dot"></span>I — Манифест
          </div>
          <h2 className="serif">
            Мы&nbsp;не&nbsp;стоим над,<br />
            мы&nbsp;идём <em>рядом</em>.
          </h2>
        </div>
        <div className="right">
          <p className="quote">
            Мода, музыка, дизайн&nbsp;— территории, где&nbsp;<span className="accent">право встречает вкус</span>. Мы&nbsp;умеем работать на&nbsp;этой границе: говорим на&nbsp;языке индустрии и&nbsp;на&nbsp;языке закона.
          </p>
          <div className="pillars">
            <div className="pillar">
              <div className="n">— 01</div>
              <h4>Свой человек в&nbsp;индустрии</h4>
              <p>Лукбук, лекало, тираж, поп-ап, релиз. Подбираем решения под&nbsp;ритм бренда, а&nbsp;не&nbsp;под&nbsp;шаблон.</p>
            </div>
            <div className="pillar">
              <div className="n">— 02</div>
              <h4>Тонкая работа со&nbsp;смыслом</h4>
              <p>Имя, силуэт, мотив, мелодия — всё это объекты права. Помогаем выстраивать архитектуру владения и&nbsp;лицензий.</p>
            </div>
            <div className="pillar">
              <div className="n">— 03</div>
              <h4>Защита без&nbsp;шума</h4>
              <p>От&nbsp;регистрации товарного знака до&nbsp;спора с&nbsp;маркетплейсом — ведём дело так, чтобы&nbsp;бренд оставался в&nbsp;сюжете, а&nbsp;не&nbsp;в&nbsp;скандале.</p>
            </div>
            <div className="pillar">
              <div className="n">— 04</div>
              <h4>Мы&nbsp;на&nbsp;вашей стороне</h4>
              <p>Не&nbsp;берём дела «в обе стороны». Если&nbsp;ваша индустрия&nbsp;— наша, мы&nbsp;уже знаем оппонента и&nbsp;его маневры.</p>
            </div>
          </div>
        </div>
      </div>
    </section>);

}

